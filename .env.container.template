# Local settings for deploy.sh and debug.sh. deploy.sh copies this file to .env.container on a first
# start; uncomment what you want to change. .env.container is yours: it is not kept in git.
#
# Every GFG_* setting the server understands is described in README.md.

# Where the log files go on the host (the default is ./data). The server runs as uid 1000.
# DATA_ROOT=./data

# Your domain; only used by the commented-out Traefik labels in docker-compose.yml
# GFG_DOMAIN=gridfinity.example.com

# The most memory the container may use. The page needs about 1g when idle and each build up to
# 0.6g more.
# GFG_MEM_LIMIT=3g

# Behind a reverse proxy (Traefik, nginx, ...): the proxy's address, or the network it is on. Only
# the X-Forwarded-* headers of these are believed. Leave it out when visitors connect directly.
# GFG_TRUSTED_PROXIES=172.18.0.0/16

# Behind https only: tell browsers to insist on https for this host, for this many seconds. It cannot be
# taken back before the time is up, so it is off unless you set it. Skip it if your proxy sends it.
# GFG_HSTS_MAX_AGE=15552000

<!doctype html>
<html lang="en">
    <head>
        {% block head %}
        <!-- Required meta tags -->
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

        <!-- Apply the saved theme before first paint, defaulting to light, to avoid a flash of the wrong theme.
             A blocking script on purpose; it is a file because the Content-Security-Policy allows no inline scripts -->
        <script src="/static/theme_init.js"></script>

        <!-- Everything is served from /static/vendor: no third-party hosts (see static/vendor/README.md) -->
        <link rel="stylesheet" href="/static/vendor/fonts/fonts.css">
        <link rel="stylesheet" href="/static/vendor/bootswatch/flatly.min.css">
        <link rel="stylesheet" href="/static/theme.css">

        <title>Gridfinity Creator</title>
        {% endblock %}
    </head>
    <body>
        <a class="visually-hidden-focusable" href="#main">Skip to the content</a>
        <!-- Your page content -->
        {% block content %}{% endblock %}

        <!-- bootstrap.bundle includes Popper; loading a second bootstrap.js would double-register
             every data-api handler and break toggles (collapse re-opens instantly) -->
        <script src="/static/vendor/bootstrap/bootstrap.bundle.min.js"></script>
        <script src="/static/vendor/three/three.min.js"></script>
        <script src=/static/safe_config.js></script>
        <script src=/static/latest_request.js></script>
        <script src=/static/library.js></script>
        <script src=/static/viewer.js></script>
        <script src=/static/theme.js></script>
        <script src=/static/tabs.js></script>
        <script src=/static/generate_feedback.js></script>
        <script src=/static/layout_editor.js></script>
        <script src=/static/holeybin_form.js></script>
        <script src=/static/previews.js></script>
        <script src=/static/page.js></script>
        {% block scripts %}{% endblock %}
    </body>
</html>
